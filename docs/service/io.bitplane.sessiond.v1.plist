<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.bitplane.sessiond.v1</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/.local/bin/bitplane-sessiond</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOU/.local/state/bitplane/sessiond/1/sessiond.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/.local/state/bitplane/sessiond/1/sessiond.log</string>
</dict>
</plist>
